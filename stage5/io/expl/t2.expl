decl
    int fact(int n);
enddecl

int fact(int n)
{
    decl
        int r;
    enddecl

    begin
        if(n==0) then
            r = 1;
        else
            r = n * fact(n-1);
        endif;

        return r;
    end
}

int main()
{
    decl
        int r;
    enddecl

    begin
        r = fact(5);
        write(r);
        return 0;
    end
}